extends partial/layout

include mixins

block site_title
    != __("Categories") + " · " + config.title

block description
    - var desc = __("Categories") + ' - ' + config.title
    meta(name="description", content=desc)

block content
    section.tags-head
        .archive-title
            .eyebrow= __('Categories')
            h1= __('Categories')
            p 按主题归类的文章集合。

    +categoryList()
