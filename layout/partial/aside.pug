aside.aside
    //- Vertical slogan from theme.title_primary, split on Chinese pipe "｜" or ascii "|"
    - var slogan = theme.title_primary || config.title || ''
    - var subLine = theme.title_secondary || ''
    - var parts = slogan.split(/[｜|]/).map(function(s){return s.trim();}).filter(Boolean)
    .verticals
        if subLine
            .v-line.v-sub= subLine
        .v-line.v-slogan
            - parts.forEach(function(p, i) {
            = p
            if i < parts.length - 1
                span.sep ／
            - });
        .v-brush

    .aside-info
        if theme.now_playing && theme.now_playing.title
            - var npAudio = theme.now_playing.audio_url
            .label 此刻 · Now Playing
            .now-playing(class=npAudio ? 'playable' : '', role=npAudio ? 'button' : null, tabindex=npAudio ? '0' : null, aria-label=npAudio ? '播放 / 暂停' : null)
                if theme.now_playing.cover
                    .np-cover
                        img(src=theme.now_playing.cover, alt=theme.now_playing.title, loading="lazy")
                        if npAudio
                            span.np-play-icon
                else
                    .np-cover
                        if npAudio
                            span.np-play-icon
                .np-text
                    .t= theme.now_playing.title
                    if theme.now_playing.artist
                        .a= theme.now_playing.artist
                .np-bars
                    i
                    i
                    i
                    i
                if npAudio
                    audio.np-audio(src=url_for(npAudio), preload="none", loop)
            .divider
        .label 数据 · Stats
        .stat-grid
            .stat
                .n= site.posts.length
                .l 文章
            .stat
                .n= site.tags.length
                .l 标签
            .stat
                .n= site.categories.length
                .l 分类
            - var pageCount = 0
            - if (site.pages) { site.pages.each(function(pp){ if(![config.tag_dir, config.category_dir, config.archive_dir].some(function(d){return pp.path.indexOf(d)===0;})) pageCount++; }); }
            .stat
                .n= pageCount
                .l 页面

        if theme.github || theme.twitter || theme.weibo || theme.instagram || theme.rss
            .divider
            .label 连接 · Links
            .aside-socials
                if theme.github
                    a(href="https://github.com/" + theme.github, target="_blank", rel="noopener noreferrer", aria-label="GitHub")
                        i.fa.fa-github
                if theme.twitter
                    a(href="https://twitter.com/" + theme.twitter, target="_blank", rel="noopener noreferrer", aria-label="Twitter")
                        i.fa.fa-twitter
                if theme.instagram
                    a(href="https://www.instagram.com/" + theme.instagram, target="_blank", rel="noopener noreferrer", aria-label="Instagram")
                        i.fa.fa-instagram
                if theme.weibo
                    a(href="http://weibo.com/u/" + theme.weibo, target="_blank", rel="noopener noreferrer", aria-label="Weibo")
                        i.fa.fa-weibo
                if theme.rss
                    a(href=config.url + "/" + theme.rss, target="_blank", rel="noopener noreferrer", aria-label="RSS")
                        i.fa.fa-rss
