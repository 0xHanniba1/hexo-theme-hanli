meta(charset="utf-8")
meta(name="X-UA-Compatible", content="IE=edge")
meta(name="author", content= theme.author)
title
    block site_title
        = config.title
block description
    meta(name="description", content= config.description ? config.description : 'A Blog Powered By Hexo')

if page.keywords
    meta(name="keywords", content= page.keywords)
else
    meta(name="keywords" content= config.keywords ? config.keywords : theme.keywords ? theme.keywords : "")

meta(content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0",name="viewport")
meta(content="yes",name="apple-mobile-web-app-capable")
meta(content="black",name="apple-mobile-web-app-status-bar-style")
meta(content="telephone=no",name="format-detection")

meta(name="renderer",content="webkit")
link(rel="short icon", href="/images/favicon.png",type="image/x-icon")

//- Restore theme before first paint to avoid FOUC
script.
    (function(){try{var t=localStorage.getItem('theme');if(t==='paper'||t==='ink'){document.documentElement.setAttribute('data-theme',t);}else{document.documentElement.setAttribute('data-theme','ink');}}catch(e){}})();

- var cssVersion = '20260418-13'
link(rel="preconnect", href="https://fonts.googleapis.com")
link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500&display=swap")

//- Keep font-awesome for nav icons & share buttons that use .fa-*
link(rel="stylesheet", href= url_for('css/font-awesome.min.css'))
link(rel="stylesheet", href= url_for('css/typo.css') + '?v=' + cssVersion)
link(rel="stylesheet", href= url_for('css/custom.css') + '?v=' + cssVersion)

if theme.search && theme.search.enable
    link(rel="stylesheet", href= url_for('css/search.css') + '?v=' + cssVersion)
link(rel="alternate" type="application/atom+xml" title="ATOM 1.0" href="/atom.xml")
