extends partial/layout

include mixins

block site_title
    != page.category + " · " + config.title

block description
    - var desc = __("Categories") + ': ' + page.category + ' - ' + config.title
    meta(name="description", content=desc)

block content
    section.tags-head
        .archive-title
            .eyebrow= __('Categories')
            h1= page.category
            p= __('CategoriesCount', page.posts.length)

    +postList()

    +make_pager()
