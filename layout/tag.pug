extends partial/layout

include mixins

block site_title
    != page.tag + " · " + config.title

block description
    - var desc = __("Tags") + ': ' + page.tag + ' - ' + config.title
    meta(name="description", content=desc)

block content
    section.tags-head
        .archive-title
            .eyebrow= __('Tags')
            h1 # #{page.tag}
            p= __('TagCount', page.posts.length)

    +postList()

    +make_pager()
