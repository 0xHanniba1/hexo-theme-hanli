extends partial/layout

include mixins

block site_title
    != page.title + " · " + config.title

block description
    - var desc = page.desc || strip_html(page.content).replace(/^\s*/, '').replace(/\s*$/, '').substring(0, 150);
    meta(name="description", content=desc)
    meta(name="og:description", content=desc)
    meta(name="twitter:site", content=config.title)
    meta(name="twitter:title", content=page.title)
    meta(name="twitter:card", content="summary")

block content
    - var words = strip_html(page.content || '').replace(/\s+/g, '').length
    - var readTime = Math.max(1, Math.round(words / 400))
    - var firstCat = (page.categories && page.categories.length) ? page.categories.data[0] : null
    - var hasToc = page.content && /<h[23][^>]*id=/.test(page.content)

    .post-page
        article.post-hero
            nav.crumbs
                a(href=config.root)= __('Home')
                span.sep /
                if firstCat
                    a(href=url_for(firstCat.path))= firstCat.name
                    span.sep /
                span= page.title
            h1.post-h1
                +beautifyTitle(page.title)
            .post-meta-row
                span.mi
                    i.fa.fa-calendar-o
                    = date(page.date, 'YYYY-MM-DD')
                span.dot
                span.mi
                    i.fa.fa-clock-o
                    = readTime + ' min read · ' + words + ' 字'
                if theme.showCategories && page.categories && page.categories.length > 0
                    span.dot
                    span.mi
                        i.fa.fa-folder-open-o
                        - page.categories.each(function(c) {
                        a(href=url_for(c.path))= c.name
                        | &nbsp;
                        - });
                if theme.showTags && page.tags && page.tags.length > 0
                    span.dot
                    span.mi
                        i.fa.fa-tags
                        - page.tags.each(function(t) {
                        a(href=url_for(t.path))= t.name
                        | &nbsp;
                        - });

        section(class= hasToc ? 'article' : 'article no-toc')
            div.prose!= page.content
            if hasToc
                aside.toc-wrap
                    .toc
                        .toc-head 目录 · Contents
                        != toc(page.content, { list_number: false, max_depth: 3 })

        - var prev = page.prev ? page.prev : null
        - var next = page.next ? page.next : null
        if prev || next
            nav.pn-nav
                if prev
                    a.pn-card.prev(href=url_for(prev.path), title=prev.title)
                        span.lbl
                            i.fa.fa-angle-left
                            | &nbsp;#{__('prev_post') || '上一篇'}
                        span.t= prev.title
                else
                    span.pn-card.empty
                if next
                    a.pn-card.next(href=url_for(next.path), title=next.title)
                        span.lbl
                            | #{__('next_post') || '下一篇'}&nbsp;
                            i.fa.fa-angle-right
                        span.t= next.title
                else
                    span.pn-card.empty

        section.comments-sec
            include partial/comments
